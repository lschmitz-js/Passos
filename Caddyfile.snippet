# Append this block to the VM's existing Caddyfile (the one used by racha).
# Caddy auto-issues a Let's Encrypt cert for the hostname.

zoologico.lbschmitz.ca, zoo.lbschmitz.ca {
    reverse_proxy passos:8080
    encode gzip
}

# After cutover, swap `passos.lbschmitz.ca` DNS to point at the VM and add
# a matching block here:
#
# passos.lbschmitz.ca {
#     reverse_proxy passos:8080
#     encode gzip
# }
#
# Then the `zoologico.lbschmitz.ca` block can be removed.
